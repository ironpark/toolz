{
	"name": "obsidian-svelte-vite-plugin",
	"version": "1.0.0",
	"packageManager": "pnpm@11.3.0",
	"description": "A modern Obsidian plugin boilerplate using Vite, Svelte 5, and TypeScript",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "vite build --watch --mode development",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"build": "pnpm run check && vite build",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.0.0",
		"eslint": "^10.9.1",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "^1.13.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"overrides": {
		"eslint": "$eslint"
	}
}

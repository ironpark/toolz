{
  "config_file": "/repo/.planr.yaml",
  "repository_root": "/repo",
  "agent": "claude",
  "language": "en",
  "plans_dirs": [
    "plan"
  ],
  "ignore": [
    "vendor"
  ],
  "hooks": {
    "timeout": "10m0s",
    "before": [
      {
        "on": [
          "done"
        ],
        "run": "go test ./..."
      }
    ],
    "after": [
      {
        "on": [
          "new"
        ],
        "run": "echo created"
      }
    ]
  }
}

#!/usr/bin/env bash
set -euo pipefail

canonical_dir() {
  (cd -- "$1" 2>/dev/null && pwd -P)
}

worktree_root=$(canonical_dir "$(git rev-parse --show-toplevel)")
git_dir=$(canonical_dir "$(git rev-parse --git-dir)")
common_dir=$(canonical_dir "$(git rev-parse --git-common-dir)")

# The primary worktree owns the common Git directory. Only commits made from a
# linked worktree should be synced back into the primary worktree.
[[ "$git_dir" != "$common_dir" ]] || exit 0

"$worktree_root/scripts/gitwt-sync"
